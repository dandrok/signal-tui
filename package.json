{
	"name": "signal-tui",
	"version": "0.0.9",
	"description": "A terminal Signal client — ink + bun, local-first with full-text search",
	"type": "module",
	"bin": {
		"signal-tui": "src/cli.tsx"
	},
	"files": [
		"src",
		"README.md",
		"SETUP.md",
		"LICENSE"
	],
	"engines": {
		"bun": ">=1.4.3"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dandrok/signal-tui.git"
	},
	"keywords": [
		"signal",
		"tui",
		"terminal",
		"ink",
		"bun",
		"messenger"
	],
	"author": "dandrok",
	"publishConfig": {
		"access": "public"
	},
	"license": "MIT",
	"scripts": {
		"start": "bun run src/cli.tsx",
		"dev": "bun run src/cli.tsx",
		"link": "bun run src/link.ts",
		"test": "bun test",
		"typecheck": "bun check",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"verify": "bun run typecheck && bun run lint && bun test",
		"setup": "bun run scripts/setup-hooks.ts",
		"doctor": "bun run src/doctor.ts",
		"prepublishOnly": "bun run verify",
		"pack:check": "bun pm pack --dry-run"
	},
	"dependencies": {
		"ink": "^8.0.0",
		"react": "^19.3.1",
		"wrap-ansi": "^10.0.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.3",
		"@types/bun": "latest",
		"@types/react": "^19.3.0",
		"ink-testing-library": "^4.0.0",
		"typescript": "^7.0.2"
	},
	"homepage": "https://github.com/dandrok/signal-tui#readme",
	"bugs": {
		"url": "https://github.com/dandrok/signal-tui/issues"
	}
}
