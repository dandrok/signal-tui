{
	"$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
	"release-type": "node",
	"include-v-in-tag": true,
	"include-component-in-tag": false,
	"bump-minor-pre-major": true,
	"packages": {
		".": {
			"release-type": "node",
			"changelog-sections": [
				{
					"type": "feat",
					"section": "Added"
				},
				{
					"type": "fix",
					"section": "Fixed"
				},
				{
					"type": "revert",
					"section": "Fixed"
				},
				{
					"type": "perf",
					"section": "Fixed"
				},
				{
					"type": "refactor",
					"section": "Internal"
				},
				{
					"type": "build",
					"section": "Internal",
					"hidden": true
				},
				{
					"type": "chore",
					"section": "Internal",
					"hidden": true
				},
				{
					"type": "ci",
					"section": "Internal",
					"hidden": true
				},
				{
					"type": "docs",
					"section": "Internal",
					"hidden": true
				},
				{
					"type": "test",
					"section": "Internal",
					"hidden": true
				}
			]
		}
	}
}
