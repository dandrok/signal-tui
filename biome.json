{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["src/**", "tests/**", "scripts/**", "*.json"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"noExcessiveLinesPerFile": {
					"level": "error",
					"options": {
						"maxLines": 200
					}
				}
			}
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["src/domain/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**/adapters/**", "**/app/**", "**/ui/**", "ink", "react"],
										"message": "domain must stay pure: no IO, no framework, no adapters"
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["tests/**"],
			"linter": {
				"rules": {
					"style": {
						"noExcessiveLinesPerFile": "off"
					}
				}
			}
		},
		{
			"includes": ["src/app/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**/adapters/**", "**/ui/**", "**/cli/**"],
										"message": "app holds use cases: it talks to ports, never to an adapter or a component"
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/ports/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"**/adapters/**",
											"**/app/**",
											"**/ui/**",
											"**/cli/**",
											"ink",
											"react",
											"zod",
											"bun:sqlite"
										],
										"message": "a port is a contract: types only, no runtime and no implementation"
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/ui/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["**/adapters/**"],
										"message": "ui talks to app state only; adapters are wired in cli.tsx"
									}
								]
							}
						}
					}
				}
			}
		}
	]
}
