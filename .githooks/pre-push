#!/bin/sh
# Full local gate: types, lint, tests.
# This hook must never pass silently — a silent skip once let unformatted code
# reach CI, where it failed the build.
set -e

if ! command -v bun >/dev/null 2>&1; then
	echo "pre-push: bun is not on PATH, so nothing was checked." >&2
	echo "          install bun (https://bun.sh) or bypass deliberately: git push --no-verify" >&2
	exit 1
fi

bun run verify
